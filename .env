# ===========================================
# LOCAL DEVELOPMENT CONFIGURATION
# ===========================================

# Environment (za lokalni razvoj)
NODE_ENV=development

# Local Development URLs (samo za server, web koristi svoje .env fajlove)
# NEXT_PUBLIC varijable se čitaju iz web/.env.production ili web/.env.development
# NEXT_PUBLIC_SERVER_URL=http://localhost:5003
# NEXT_PUBLIC_API_URL=http://localhost:5003/api
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Configuration - Konekcija kroz SSH tunel na produkcijsku bazu
# NAPOMENA: Koristi port 27018 jer SSH tunel forward-uje produkcijsku bazu na taj port
# Pokreni SSH tunel sa: ./server/start-ssh-tunnel.sh
MONGODB_URI=mongodb://avdoAdmin:WanNeAvdo1994@127.0.0.1:27018/Predavanja?authSource=admin

# Production MongoDB Configuration (za deployment)
MONGODB_URI_PRODUCTION=mongodb://avdoAdmin:WanNeAvdo1994@194.163.176.171:27017/Predavanja?authSource=admin

# JWT Secret Key
JWT_SECRET=neka-jaka-tajna-AvdoWanNe1994

# Server Port
PORT=5003

# Debug Settings (enabled in development)
DEBUG=true
LOG_LEVEL=debug

# ===========================================
# PRODUCTION DEPLOYMENT CONFIGURATION
# (Komentarisano za lokalni razvoj)
# ===========================================

DEPLOY_HOST=194.163.176.171
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_DOMAIN=ders.ba
SSH_KEY_PATH=/home/avdo/.ssh/id_ed25519
SSH_PASSPHRASE=WanNeAvdo1994

# Napomena: Za produkciju, odkomentiraj gornje linije i promijeni NODE_ENV na 'production' 