# ===========================================
# EXAMPLE ENVIRONMENT CONFIGURATION
# ===========================================
# Kopiraj ovaj fajl kao .env i prilagodi vrijednosti

# Environment (development ili production)
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/Predavanja
MONGODB_URI_PRODUCTION=mongodb://username:password@host:port/database?authSource=admin

# JWT Secret Key (promijeni u produkciji!)
JWT_SECRET=your-secret-key-here

# Server Port
PORT=5003

# Debug Settings
DEBUG=true
LOG_LEVEL=debug

# ===========================================
# DEPLOYMENT CONFIGURATION (za produkciju)
# ===========================================
DEPLOY_HOST=your-server-ip
DEPLOY_USER=your-username
DEPLOY_PORT=22
DEPLOY_DOMAIN=your-domain.com
SSH_KEY_PATH=path/to/your/ssh/key
SSH_PASSPHRASE=your-ssh-passphrase

# ===========================================
# NAPOMENE:
# ===========================================
# 1. Frontend koristi svoje .env fajlove u web/ direktoriju
# 2. Backend koristi svoje .env fajlove u server/ direktoriju
# 3. Ovaj glavni .env se koristi za deployment skripte
# 4. NIKAD ne commituj prave .env fajlove u git! 