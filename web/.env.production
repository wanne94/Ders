# ===========================================
# FRONTEND - PRODUCTION ENVIRONMENT
# ===========================================

# Environment
NODE_ENV=production

# API & Server URLs
NEXT_PUBLIC_API_URL=http://localhost:5004/api
NEXT_PUBLIC_SERVER_URL=http://localhost:5004
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=wss://ders.ba

# Authentication
NEXT_PUBLIC_JWT_STORAGE_KEY=predavanje_token
NEXT_PUBLIC_SESSION_TIMEOUT=1800000

# Debug & Development Tools (disabled in production)
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_LOG_LEVEL=error
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false
NEXT_PUBLIC_ENABLE_REDUX_DEVTOOLS=false

# Features Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_PWA=true

# Performance & Caching (optimized for production)
NEXT_PUBLIC_CACHE_MAX_AGE=3600
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_LAZY_LOADING=true

# Analytics & Monitoring
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_TRACKING_ID=

# File Upload (stricter limits for production)
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# UI & UX
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_LANGUAGE=sr
NEXT_PUBLIC_ENABLE_ANIMATIONS=true
NEXT_PUBLIC_SHOW_LOADING_INDICATORS=false

# Security
NEXT_PUBLIC_ENABLE_CSP=true
NEXT_PUBLIC_SECURE_COOKIES=true 