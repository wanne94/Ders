{
  "name": "predavanje",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS='--no-deprecation' next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "test:production": "npm run build && npm run start",
    "server": "cd ../server && npm start",
    "server:dev": "cd ../server && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "start:full": "concurrently \"npm run start\" \"npm run server\"",
    "clean": "rimraf .next",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@date-io/date-fns": "^2.16.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/base": "^5.0.0-beta.22",
    "@mui/icons-material": "5.15.15",
    "@mui/material": "5.15.15",
    "@mui/system": "^5.15.0",
    "@mui/utils": "^5.15.0",
    "@mui/x-date-pickers": "6.20.2",
    "@swc/helpers": "^0.5.15",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.9.0",
    "date-fns": "^2.30.0",
    "dom-helpers": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "faker": "^5.5.3",
    "jwt-decode": "^4.0.0",
    "morgan": "^1.10.0",
    "next": "^15.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.0",
    "styled-jsx": "^5.1.7",
    "web-vitals": "^2.1.4",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@emotion/babel-plugin": "^11.13.5",
    "babel-loader": "^10.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "multer": "^2.0.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "serve": "^14.2.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
