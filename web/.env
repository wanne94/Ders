# ===========================================
# DYNAMIC ENVIRONMENT VARIABLES
# ===========================================
# NODE_ENV se postavlja dinamički preko npm skripti
# development: npm run dev (NODE_ENV=development)
# production: npm run build && npm start (NODE_ENV=production)

# Local development URLs (koriste se kada je NODE_ENV=development)
NEXT_PUBLIC_API_URL=https://ders.ba/api
NEXT_PUBLIC_SERVER_URL=https://ders.ba
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy VITE support (ako se koristi)
VITE_API_URL=https://ders.ba/api

# Debug Settings (enabled in development)
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_LOG_LEVEL=debug

# Features Flags (for development)
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true

# Performance & Security
NEXT_PUBLIC_CACHE_MAX_AGE=0
NEXT_PUBLIC_ENABLE_ANALYTICS=false