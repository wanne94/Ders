import { useState, useEffect } from 'react';
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  Dimensions,
  Alert,
  ActivityIndicator,
  TouchableOpacity,
  Image,
  Linking,
  Share,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { usersService } from '../services/usersService';
import { getImageUrl } from '../utils/imageUtils';
import { formatDateWithDay } from '../utils/dateUtils';
import { getUserData } from '../utils/authHelpers';

const { width, height } = Dimensions.get('window');

const COLORS = {
  primary: '#022C43',
  primaryLight: '#055A87',
  white: '#ffffff',
  gray: '#666666',
  lightGray: '#f5f5f5',
  border: '#e0e0e0',
  warning: '#FFA726',
  success: '#66BB6A',
  error: '#ef5350',
};

const ProfileScreen = ({ navigation, route }) => {
  const { profileId, profileType = 'user' } = route.params || {};
  
  const [profileData, setProfileData] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    fetchProfileData();
  }, [profileId, profileType]);

  const fetchProfileData = async () => {
    try {
      setIsLoading(true);
      setError(null);

      if (profileType === 'user' && profileId) {
        // Get user data from local storage first
        const currentUser = await getUserData();
        if (currentUser && currentUser._id === profileId) {
          // If it's the current user, use local data
          setProfileData(currentUser);
        } else {
          // Otherwise fetch from API
          const userData = await usersService.getUserById(profileId);
          setProfileData(userData);
        }
      } else {
        setError('Tip profila nije podržan');
      }
    } catch (error) {
      console.error('Error fetching profile data:', error);
      setError(error.response?.data?.message || 'Greška pri učitavanju profila');
    } finally {
      setIsLoading(false);
    }
  };

  const handleBackPress = () => {
    navigation.goBack();
  };

  const handleShare = async () => {
    if (!profileData) return;

    try {
      const shareOptions = {
        message: `Pogledajte profil: ${profileData.firstName} ${profileData.lastName}`,
        title: `Profil - ${profileData.firstName} ${profileData.lastName}`,
      };

      await Share.share(shareOptions);
    } catch (error) {
      console.error('Error sharing profile:', error);
    }
  };

  const openLocationInMaps = (address, city) => {
    if (!address && !city) return;
    
    const fullAddress = [address, city].filter(Boolean).join(', ');
    const encodedAddress = encodeURIComponent(fullAddress);
    
    const mapsUrl = `https://maps.google.com/maps?q=${encodedAddress}`;
    
    Linking.openURL(mapsUrl).catch(err => {
      console.error('Error opening maps:', err);
      Alert.alert('Greška', 'Nije moguće otvoriti mapu');
    });
  };

  if (isLoading) {
    return (
      <View style={styles.loadingContainer}>
        <ActivityIndicator size="large" color={COLORS.primary} />
        <Text style={styles.loadingText}>Učitavam profil...</Text>
      </View>
    );
  }

  if (error) {
    return (
      <View style={styles.errorContainer}>
        <View style={styles.errorContent}>
          <Ionicons name="alert-circle-outline" size={48} color={COLORS.error} />
          <Text style={styles.errorText}>{error}</Text>
          <TouchableOpacity style={styles.retryButton} onPress={fetchProfileData}>
            <Text style={styles.retryButtonText}>Pokušaj ponovo</Text>
          </TouchableOpacity>
          <TouchableOpacity style={styles.backButton} onPress={handleBackPress}>
            <Ionicons name="arrow-back" size={20} color={COLORS.white} />
            <Text style={styles.backButtonText}>Nazad</Text>
          </TouchableOpacity>
        </View>
      </View>
    );
  }

  if (!profileData) {
    return (
      <View style={styles.errorContainer}>
        <View style={styles.errorContent}>
          <Ionicons name="person-outline" size={48} color={COLORS.gray} />
          <Text style={styles.errorText}>Profil nije pronađen</Text>
          <TouchableOpacity style={styles.backButton} onPress={handleBackPress}>
            <Ionicons name="arrow-back" size={20} color={COLORS.white} />
            <Text style={styles.backButtonText}>Nazad</Text>
          </TouchableOpacity>
        </View>
      </View>
    );
  }

  return (
    <ScrollView style={styles.container} showsVerticalScrollIndicator={false}>
      {/* Header with back button */}
      <View style={styles.header}>
        <TouchableOpacity style={styles.headerBackButton} onPress={handleBackPress}>
          <Ionicons name="arrow-back" size={24} color={COLORS.white} />
        </TouchableOpacity>
        <Text style={styles.headerTitle}>Profil</Text>
        <TouchableOpacity style={styles.headerShareButton} onPress={handleShare}>
          <Ionicons name="share-outline" size={24} color={COLORS.white} />
        </TouchableOpacity>
      </View>

      {/* Profile Hero Section */}
      <View style={styles.heroSection}>
        <View style={styles.profileImageContainer}>
          <View style={styles.profileInitialsContainer}>
            <Text style={styles.profileInitials}>
              {profileData.username ? profileData.username.charAt(0).toUpperCase() : 'K'}
            </Text>
          </View>
        </View>
        
        <View style={styles.profileInfo}>
          <Text style={styles.profileName}>
            {profileData.username || 'Nepoznat korisnik'}
          </Text>
          
          {profileData.rid && (
            <View style={styles.ridContainer}>
              <Ionicons name="card-outline" size={16} color={COLORS.gray} />
              <Text style={styles.ridText}>RID: {profileData.rid}</Text>
            </View>
          )}
          
          {profileData.role && (
            <View style={styles.roleBadge}>
              <Text style={styles.roleText}>
                {profileData.role === 'super_admin' ? 'Super Admin' : 
                 profileData.role === 'admin' ? 'Admin' : 'Korisnik'}
              </Text>
            </View>
          )}
        </View>
      </View>

      {/* Profile Details */}
      <View style={styles.detailsSection}>
        <Text style={styles.sectionTitle}>Osnovne informacije</Text>
        
        {profileData.email && (
          <View style={styles.detailItem}>
            <Ionicons name="mail-outline" size={20} color={COLORS.primary} />
            <Text style={styles.detailText}>
              {profileData.email}
            </Text>
          </View>
        )}

        {profileData.createdAt && (
          <View style={styles.detailItem}>
            <Ionicons name="calendar-outline" size={20} color={COLORS.primary} />
            <Text style={styles.detailText}>
              Član od: {formatDateWithDay(profileData.createdAt)}
            </Text>
          </View>
        )}
      </View>
    </ScrollView>
  );
};

