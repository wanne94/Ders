{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NODE_ENV": "production"
      },
      "cache": {
        "disabled": false
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "enterpriseProvisioning": "adhoc"
      }
    },
    "production": {
      "developmentClient": false,
      "env": {
        "NODE_ENV": "production",
        "ANDROID_HOME": "/Users/wanne/Library/Android/sdk",
        "ANDROID_SDK_ROOT": "/Users/wanne/Library/Android/sdk",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@17"
      },
      "cache": {
        "disabled": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
