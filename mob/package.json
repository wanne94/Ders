{
  "name": "mobile-app",
  "version": "1.1.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "EXPO_ENV=development expo start",
    "start:prod": "EXPO_ENV=production expo start",
    "android": "expo run:android",
    "android:dev": "EXPO_ENV=development expo start --android",
    "android:prod": "EXPO_ENV=production expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "expo": "expo start --clear",
    "expo:tunnel": "expo start --tunnel",
    "expo:lan": "expo start --lan",
    "build-apk": "cd android && ./gradlew clean && NODE_ENV=production ./gradlew assembleRelease",
    "build-aab": "cd android && ./gradlew clean && NODE_ENV=production ./gradlew bundleRelease",
    "build-apk-debug": "cd android && ./gradlew assembleDebug",
    "build-clean": "cd android && ./gradlew clean",
    "build-info": "cd android && ./gradlew app:dependencies",
    "prebuild": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --platform android --clean",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.15",
    "@react-navigation/native": "^7.1.11",
    "@react-navigation/stack": "^7.3.4",
    "date-fns": "^2.30.0",
    "es-abstract": "^1.22.5",
    "expo": "53.0.20",
    "expo-build-properties": "~0.14.6",
    "expo-calendar": "^14.1.4",
    "expo-constants": "^17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-device": "^7.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.17",
    "jwt-decode": "^4.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-dotenv": "^3.4.9",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-version-check": "^3.5.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/config-plugins": "~10.1.1",
    "@expo/prebuild-config": "~9.0.0",
    "@types/react": "~18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^9.29.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "metro": "^0.82.4",
    "metro-config": "^0.82.4",
    "metro-core": "^0.82.4",
    "metro-resolver": "^0.82.4",
    "typescript": "^5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
