import React, { useState } from 'react';
import { View, StyleSheet, Text, StatusBar } from 'react-native';
import { SafeAreaProvider } from 'react-native-safe-area-context';
import BottomNavigation from './components/BottomNavigation';
import UniversalPage from './screens/UniversalPage';
import AuthScreen from './screens/AuthScreen';
import AddContentScreen from './screens/AddContentScreen';
import ProfileScreen from './screens/ProfileScreen';
import DashboardScreen from './screens/DashboardScreen';

export default function App() {
  const [activeTab, setActiveTab] = useState('home');
  // User state - starts as null (not authenticated)
  const [user, setUser] = useState(null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);

  const handleTabPress = (tabId) => {
    setActiveTab(tabId);
  };

  const handleNavigate = (path) => {
    setActiveTab(path);
  };

  const handleAuthNavigate = () => {
    setActiveTab('auth');
  };

  const handleLogout = () => {
    setUser(null);
    setIsAuthenticated(false);
    setActiveTab('home');
  };

  const handleAddContent = () => {
    setActiveTab('add-content');
  };

  const handleAddContentWithType = (type) => {
    // TODO: Implement specific content type adding
    setActiveTab('add-content');
  };

  const handleProfileNavigate = (userId, type) => {
    // TODO: Implement profile navigation
    setActiveTab('profile');
  };

  const renderContent = () => {
    switch (activeTab) {
      case 'home':
        return <UniversalPage key="home-lectures" type="lectures" onNavigate={handleNavigate} user={user} isAuthenticated={isAuthenticated} />;
      case 'lectures':
        return <UniversalPage key="lectures" type="lectures" onNavigate={handleNavigate} user={user} isAuthenticated={isAuthenticated} />;
      case 'speakers':
        return <UniversalPage key="speakers" type="speakers" onNavigate={handleNavigate} user={user} isAuthenticated={isAuthenticated} />;
      case 'organizations':
        return <UniversalPage key="organizations" type="organizations" onNavigate={handleNavigate} user={user} isAuthenticated={isAuthenticated} />;
      case 'auth':
        return (
          <AuthScreen 
            onBack={() => setActiveTab('home')}
            onAuthSuccess={(userData) => {
              setUser(userData);
              setIsAuthenticated(true);
              setActiveTab('home');
            }}
          />
        );
      case 'add-content':
        return (
          <AddContentScreen 
            onBack={() => setActiveTab('home')}
            onContentAdded={() => {
              setActiveTab('home');
              // TODO: Refresh data
            }}
          />
        );
      case 'profile':
        return (
          <ProfileScreen 
            onBack={() => setActiveTab('home')}
            user={user}
          />
        );
      case 'dashboard':
        return (
          <DashboardScreen 
            onBack={() => setActiveTab('home')}
            user={user}
          />
        );
      default:
        return (
          <View style={styles.defaultContent}>
            <Text style={styles.defaultText}>Sadržaj za {activeTab}</Text>
          </View>
        );
    }
  };

  return (
    <SafeAreaProvider>
      <StatusBar barStyle="light-content" backgroundColor="#022C43" translucent={false} />
      <View style={styles.container}>
        {renderContent()}
        {/* Hide bottom navigation for some screens */}
        {!['add-content', 'profile', 'dashboard'].includes(activeTab) && (
          <BottomNavigation 
            activeTab={activeTab} 
            onTabPress={handleTabPress} 
          />
        )}
      </View>
    </SafeAreaProvider>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#f0f0f0',
  },
  defaultContent: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
  },
  defaultText: {
    fontSize: 18,
    fontWeight: 'bold',
    color: '#666',
  },
  subtitle: {
    fontSize: 14,
    color: '#999',
    marginTop: 8,
  },
});