# ===========================================
# BACKEND - PRODUCTION ENVIRONMENT
# ===========================================

# Environment
NODE_ENV=production

# Database Configuration
# Direktna konekcija na produkcijski MongoDB server
MONGODB_URI=mongodb://avdoAdmin:WanNeAvdo1994@127.0.0.1:27017/Predavanja?authSource=admin
DB_NAME=Predavanja

# Backup opcije:
# MONGODB_URI=mongodb://avdoAdmin:WanNeAvdo1994@localhost:27018/Predavanja?authSource=admin
# MONGODB_URI=mongodb+srv://avdoAdmin:WanNeAvdo1994@cluster0.mongodb.net/Predavanja?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=WanNeAvdo1994
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Server Configuration
PORT=5003
HOST=0.0.0.0
CORS_ORIGIN=https://ders.ba

# File Upload Configuration
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Debug & Logging (restricted in production)
DEBUG=false
LOG_LEVEL=error
ENABLE_REQUEST_LOGGING=false

# Email Configuration (production SMTP)
EMAIL_SERVICE=production
EMAIL_FROM=noreply@ders.ba
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=WanNeAvdo1994

# Rate Limiting (strože za production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=WanNeAvdo1994
SESSION_MAX_AGE=3600000

# SSL & Security Headers
FORCE_HTTPS=true
TRUST_PROXY=true

# Monitoring & Performance
ENABLE_COMPRESSION=true
ENABLE_HELMET=true 