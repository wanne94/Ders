# ===========================================
# BACKEND - ENVIRONMENT TEMPLATE
# ===========================================
# Kopiraj u .env.development (lokalno) ili .env.production (server) i popuni vrijednosti.

NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ders_dev
DB_NAME=ders_dev

# Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Server Configuration
PORT=5004
HOST=localhost
CORS_ORIGIN=http://localhost:3001

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Debug & Logging
DEBUG=true
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# Email Configuration
EMAIL_SERVICE=development
EMAIL_FROM=dev@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Session Configuration
SESSION_SECRET=
SESSION_MAX_AGE=86400000

# Firebase (opciono, push notifikacije)
# Stavi service account JSON na server/config/firebase-service-account.json

# Seed admin skripta (server/scripts/seed-admin.js)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECURITY_ANSWER=
