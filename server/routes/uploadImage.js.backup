const express = require('express');
const router = express.Router();
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const sharp = require('sharp');
const { v4: uuidv4 } = require('uuid');

// Helper function for cleaning up temp files with retry logic (Windows fix)
const cleanupTempFile = async (filePath, maxRetries = 5, delay = 100) => {
  for (let i = 0; i < maxRetries; i++) {
    try {
      if (fs.existsSync(filePath)) {
        fs.unlinkSync(filePath);
        console.log('🗑️ Temp file deleted:', filePath);
        return;
      }
      return; // File doesn't exist, nothing to clean up
    } catch (error) {
      if (error.code === 'EBUSY' && i < maxRetries - 1) {
        console.log(`⏳ File busy, retrying in ${delay}ms... (attempt ${i + 1}/${maxRetries})`);
        await new Promise(resolve => setTimeout(resolve, delay));
        delay *= 2; // Exponential backoff
      } else {
        console.error('❌ Error cleaning up temp file:', error);
        return; // Give up after all retries
      }
    }
  }
};

// Define CDN directory structure
const cdnBaseDir = path.join(__dirname, '../cdn/images');
const cdnDirs = {
  uploads: path.join(cdnBaseDir, 'uploads'),
  defaults: path.join(cdnBaseDir, 'defaults'),
  thumbnails: path.join(cdnBaseDir, 'thumbnails')
};

// Legacy upload directory for backward compatibility
const legacyUploadsDir = path.join(__dirname, '../uploads/images');

console.log('📁 CDN configuration:', {
  environment: process.env.NODE_ENV,
  cdnBaseDir: cdnBaseDir,
  cdnDirs: cdnDirs,
  cdnExists: fs.existsSync(cdnBaseDir)
});

// Create CDN directories if they don't exist
try {
  Object.values(cdnDirs).forEach(dir => {
    if (!fs.existsSync(dir)) {
      fs.mkdirSync(dir, { recursive: true });
      console.log('✅ Created CDN directory:', dir);
    }
  });
  
  // Also create legacy directory for backward compatibility
  if (!fs.existsSync(legacyUploadsDir)) {
    fs.mkdirSync(legacyUploadsDir, { recursive: true });
    console.log('✅ Created legacy uploads directory:', legacyUploadsDir);
  }
} catch (error) {
  console.error('❌ Error creating directories:', error);
}

// Configure multer for handling file uploads
const storage = multer.memoryStorage(); // Use memory storage for processing with Sharp

const upload = multer({
  storage,
  limits: {
    fileSize: 5 * 1024 * 1024, // 5MB limit
  },
  fileFilter: (req, file, cb) => {
    const allowedMimeTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
    if (allowedMimeTypes.includes(file.mimetype)) {
      cb(null, true);
    } else {
      cb(new Error('Only image files are allowed! (JPEG, PNG, GIF, WebP)'), false);
    }
  }
});

// Image size configurations
const imageSizes = {
  original: { width: 1920, quality: 80, suffix: 'original' },
  medium: { width: 800, quality: 75, suffix: 'medium' },
  thumb: { width: 200, quality: 70, suffix: 'thumb' }
};

// Helper function to process image in multiple sizes
const processImageSizes = async (buffer, baseFileName) => {
  const results = {};
  
  for (const [sizeName, config] of Object.entries(imageSizes)) {
    try {
      const webpFileName = `${baseFileName}-${config.suffix}.webp`;
      const jpegFileName = `${baseFileName}-${config.suffix}.jpg`;
      
      const webpPath = path.join(cdnDirs.uploads, webpFileName);
      const jpegPath = path.join(cdnDirs.uploads, jpegFileName);
      
      // Generate WebP version
      await sharp(buffer)
        .resize({
          width: config.width,
          withoutEnlargement: true
        })
        .webp({ 
          quality: config.quality,
          effort: 6
        })
        .toFile(webpPath);
      
      // Generate JPEG fallback
      await sharp(buffer)
        .resize({
          width: config.width,
          withoutEnlargement: true
        })
        .jpeg({ 
          quality: config.quality,
          progressive: true
        })
        .toFile(jpegPath);
      
      results[sizeName] = {
        webp: `/cdn/images/uploads/${webpFileName}`,
        jpeg: `/cdn/images/uploads/${jpegFileName}`,
        size: fs.statSync(webpPath).size
      };
      
    } catch (error) {
      console.error(`❌ Error processing ${sizeName} size:`, error);
      throw error;
    }
  }
  
  return results;
};

// Test endpoint
router.get('/test', (req, res) => {
  res.json({
    message: 'Upload endpoint is working',
    environment: process.env.NODE_ENV,
    cdnDirs: cdnDirs,
    cdnExists: fs.existsSync(cdnBaseDir),
    timestamp: new Date().toISOString()
  });
});

// Upload endpoint with multi-size generation
router.post('/', upload.single('image'), async (req, res) => {
  console.log('🔄 Upload endpoint hit');
  console.log('📁 Request details:', {
    method: req.method,
    url: req.url,
    environment: process.env.NODE_ENV,
    file: req.file ? {
      fieldname: req.file.fieldname,
      originalname: req.file.originalname,
      mimetype: req.file.mimetype,
      size: req.file.size
    } : 'No file'
  });

  if (!req.file) {
    console.log('❌ No file uploaded');
    return res.status(400).json({ success: false, message: 'No file uploaded' });
  }

  try {
    const originalSize = req.file.size;
    const baseFileName = uuidv4();
    
    console.log('🔄 Starting multi-size image processing...');
    
    // Get metadata from buffer
    const metadata = await sharp(req.file.buffer).metadata();
    
    console.log('📊 Original image metadata:', {
      width: metadata.width,
      height: metadata.height,
      format: metadata.format,
      size: originalSize
    });

    // Process all image sizes
    const processedImages = await processImageSizes(req.file.buffer, baseFileName);
    
    // For backward compatibility, also save to legacy location
    const legacyFileName = `optimized-${Date.now()}.webp`;
    const legacyPath = path.join(legacyUploadsDir, legacyFileName);
    
    await sharp(req.file.buffer)
      .resize({
        height: 1080,
        width: undefined,
        withoutEnlargement: true
      })
      .webp({ 
        quality: 85,
        effort: 6
      })
      .toFile(legacyPath);
    
    // Calculate total compression
    const totalSize = Object.values(processedImages).reduce((sum, img) => sum + img.size, 0);
    const avgCompressionRatio = ((originalSize - totalSize / 3) / originalSize * 100).toFixed(2);
    
    console.log('✅ Image processing completed:', {
      originalSize: originalSize,
      sizes: processedImages,
      compressionRatio: `${avgCompressionRatio}%`
    });

    // Return response with both new CDN paths and legacy path
    res.json({
      success: true,
      // Primary CDN path (use medium size as default)
      path: processedImages.medium.webp,
      // Legacy path for backward compatibility
      legacyPath: `/uploads/images/${legacyFileName}`,
      // All available sizes
      sizes: processedImages,
      // Metadata
      filename: baseFileName,
      originalSize: originalSize,
      compressionRatio: `${avgCompressionRatio}%`,
      dimensions: {
        width: metadata.width,
        height: metadata.height
      }
    });

  } catch (error) {
    console.error('❌ Image processing error:', error);
    
    res.status(500).json({
      success: false,
      message: 'Greška pri obradi slike',
      error: 'PROCESSING_ERROR',
      details: error.message
    });
  }
});

// Error handling middleware
router.use((error, req, res, next) => {
  if (error instanceof multer.MulterError) {
    if (error.code === 'LIMIT_FILE_SIZE') {
      return res.status(400).json({
        success: false,
        message: 'Slika je prevelika. Maksimalna veličina je 5MB.',
        error: 'FILE_TOO_LARGE'
      });
    }
    return res.status(400).json({
      success: false,
      message: `Upload error: ${error.message}`,
      error: 'UPLOAD_ERROR'
    });
  }

  if (error) {
    return res.status(400).json({
      success: false,
      message: error.message,
      error: 'GENERAL_ERROR'
    });
  }

  next();
});

module.exports = router;