# Environment
NODE_ENV=development

# Database Configuration
# Always use production database - no local database
MONGODB_URI=mongodb://avdoAdmin:WanNeAvdo1994@194.163.176.171:27017/Predavanja?authSource=admin

DB_NAME=Predavanja

# Authentication & Security
JWT_SECRET=neka-jaka-tajna-AvdoWanNe1994
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Server Configuration
PORT=5003
HOST=localhost
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Debug & Logging
DEBUG=true
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# Email Configuration (development - može biti mock)
EMAIL_SERVICE=development
EMAIL_FROM=dev@localhost
SMTP_HOST=localhost
SMTP_PORT=1025

# Rate Limiting (blažije za development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Session Configuration
SESSION_SECRET=dev-session-secret-key
SESSION_MAX_AGE=86400000
