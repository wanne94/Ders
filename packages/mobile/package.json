{
  "name": "mobile-app",
  "version": "1.3.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "EXPO_ENV=development expo start",
    "start:prod": "EXPO_ENV=production expo start",
    "android": "expo run:android",
    "android:dev": "EXPO_ENV=development expo start --android",
    "android:prod": "EXPO_ENV=production expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "expo:clear": "expo start --clear",
    "expo:tunnel": "expo start --tunnel",
    "expo:lan": "expo start --lan",
    "build-apk": "cd android && ./gradlew clean && NODE_ENV=production ./gradlew assembleRelease",
    "build-aab": "cd android && ./gradlew clean && NODE_ENV=production ./gradlew bundleRelease",
    "build-apk-debug": "cd android && ./gradlew assembleDebug",
    "build-clean": "cd android && ./gradlew clean",
    "build-info": "cd android && ./gradlew app:dependencies",
    "prebuild": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --platform android --clean",
    "ios": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "ios:simulator": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "ios:device": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios --device",
    "ios:start": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo start --ios"
  },
  "dependencies": {
    "@ders-ba/shared": "file:../shared",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.15",
    "@react-navigation/native": "^7.1.11",
    "@react-navigation/stack": "^7.3.4",
    "date-fns": "^2.30.0",
    "es-abstract": "^1.22.5",
    "expo": "~54.0.12",
    "expo-build-properties": "~1.0.9",
    "expo-calendar": "~15.0.7",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.12",
    "expo-device": "~8.0.8",
    "expo-font": "~14.0.8",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.11",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-dotenv": "^3.4.9",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-version-check": "^3.5.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^20.0.1",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^9.29.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "metro": "^0.83.1",
    "metro-config": "^0.82.4",
    "metro-core": "^0.82.4",
    "metro-resolver": "^0.82.4",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-version-check"
        ]
      }
    }
  },
  "private": true
}
