# ===========================================
# FRONTEND - DEVELOPMENT ENVIRONMENT
# ===========================================

# Environment
NODE_ENV=development

# API & Server URLs
NEXT_PUBLIC_API_URL=http://localhost:5003/api
NEXT_PUBLIC_SERVER_URL=http://localhost:5003
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=wss://ders.ba

# Authentication
NEXT_PUBLIC_JWT_STORAGE_KEY=predavanje_token
NEXT_PUBLIC_SESSION_TIMEOUT=3600000

# Debug & Development Tools
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true
NEXT_PUBLIC_ENABLE_REDUX_DEVTOOLS=true

# Features Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false
NEXT_PUBLIC_ENABLE_PWA=false

# Performance & Caching
NEXT_PUBLIC_CACHE_MAX_AGE=0
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
NEXT_PUBLIC_LAZY_LOADING=true

# Analytics & Monitoring
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_SENTRY_DSN=

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# UI & UX
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_LANGUAGE=sr
NEXT_PUBLIC_ENABLE_ANIMATIONS=true
NEXT_PUBLIC_SHOW_LOADING_INDICATORS=true
FAST_REFRESH=false
