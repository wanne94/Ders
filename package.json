{
  "name": "predavanje-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:full",
    "dev:web": "cd web && npm run dev",
    "dev:mobile": "cd mobile && npm run start",
    "dev:server": "cd server && npm run dev",
    "dev:full": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:mobile\" \"npm run dev:server\"",
    "start": "npm run start:full",
    "start:web": "cd web && npm run start",
    "start:mobile": "cd mobile && npm run start",
    "start:server": "cd server && npm run start",
    "start:full": "concurrently \"npm run start:web\" \"npm run start:server\"",
    "build": "npm run build:all",
    "build:web": "cd web && npm run build",
    "build:mobile": "cd mobile && npm run build",
    "build:server": "cd server && npm run build",
    "build:all": "npm run build:server && npm run build:web && npm run build:mobile",
    "type-check": "npm run type-check:all",
    "type-check:web": "cd web && npm run type-check",
    "type-check:server": "cd server && npm run type-check",
    "type-check:all": "concurrently \"npm run type-check:web\" \"npm run type-check:server\"",
    "deploy:prepare": "node prepare-deployment.js",
    "deploy": "node deploy.js",
    "deploy:quick": "node deploy-quick.js",
    "deploy:test": "node test-deployment.js",
    "test:mobile": "node test-mobile-connection.js",
    "install:all": "npm install && cd web && npm install && cd ../mobile && npm install && cd ../server && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "expo": "^53.0.10",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.1.10",
    "axios": "^1.7.9",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "safer-buffer": "^2.1.2"
  }
}
