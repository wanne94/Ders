{
  "name": "predavanje-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:web": "cd web && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:shared": "cd shared && npm run dev",
    "dev:full": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "start:full": "concurrently \"npm run start:web\" \"npm run start:server\"",
    "build": "cd web && npm run build",
    "build:shared": "cd shared && npm run build",
    "build:all": "npm run build:shared && npm run build",
    "deploy:prepare": "node prepare-deployment.js",
    "install:all": "npm install && cd web && npm install && cd ../mobile && npm install && cd ../server && npm install && cd ../shared && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@mui/x-date-pickers": "^6.20.2",
    "axios": "^1.9.0",
    "multer": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
