{
  "name": "ders-ba",
  "version": "1.3.0",
  "description": "DERS.BA Monorepo - Web & Mobile Applications",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --kill-others --handle-input \"cd server && npm run dev\" \"cd packages/web && npm run dev\"",
    "dev:server": "concurrently \"./start-tunnel.sh\" \"cd server && npm run dev\"",
    "dev:web": "cd packages/web && npm run dev",
    "dev:mobile": "cd packages/mobile && npm start",
    "stop": "pkill -f 'npm run dev' || killall node nodemon || true",
    "build": "cd packages/web && npm run build",
    "build:mobile": "cd packages/mobile && eas build",
    "start": "cd packages/web && npm start",
    "lint": "cd packages/web && npm run lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:web": "cd packages/web && npm run pre-deploy",
    "test:pre-deploy": "cd packages/web && node tests/pre-deploy.test.js",
    "deploy": "node deploy-complete.js deploy",
    "deploy:web": "node deploy-complete.js web",
    "deploy:server": "node deploy-complete.js server",
    "deploy:full": "node deploy-complete.js full",
    "deploy:quick": "npm run deploy",
    "deploy:legacy": "npm run deploy:server && npm run deploy:web",
    "health": "node deploy-complete.js health",
    "health:check": "node scripts/health-check.js",
    "backup": "node deploy-complete.js backup",
    "backup:create": "node scripts/backup.js",
    "backup:daily": "0 0 * * * node scripts/backup.js",
    "logs": "ssh -p $DEPLOY_PORT $DEPLOY_USER@$DEPLOY_HOST 'pm2 logs'",
    "monitor": "ssh -p $DEPLOY_PORT $DEPLOY_USER@$DEPLOY_HOST 'pm2 monit'",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/cli": "^0.24.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "chalk": "^5.6.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "expo": "~54.0.0",
    "express-async-handler": "^1.2.0",
    "metro": "0.83.1",
    "metro-cache": "^0.82.4",
    "mongoose": "^8.18.2",
    "node-fetch": "^2.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "ssh2": "^1.16.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.2.1",
    "babel-jest": "^30.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.37.0"
  }
}
